# Onlenco production environment for sudaschool.academy.
# Copy to `.env` on the server and fill the placeholder values.
#
#   cp .env.production.example .env
#   # edit .env — replace every <CHANGE_ME> token

# --- Django core ---
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=<CHANGE_ME_to_a_50plus_char_random_string>
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=sudaschool.academy,www.sudaschool.academy
DJANGO_CSRF_TRUSTED_ORIGINS=https://sudaschool.academy,https://www.sudaschool.academy
ONLENCO_BASE_URL=https://sudaschool.academy

# Reverse proxy (Caddy / Nginx) terminates TLS and sets X-Forwarded-Proto.
DJANGO_SECURE_SSL_REDIRECT=1

# --- Database (Postgres in compose) ---
POSTGRES_DB=onlenco
POSTGRES_USER=onlenco
POSTGRES_PASSWORD=<CHANGE_ME_strong_random_password>
POSTGRES_HOST=db
POSTGRES_PORT=5432
DJANGO_DB_SSL_REQUIRE=0

# --- Static / media ---
DJANGO_STATIC_URL=/static/
DJANGO_MEDIA_URL=/media/

# --- Email (use your real SMTP provider; SendGrid / SES / Mailgun) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=<CHANGE_ME_smtp_host>
EMAIL_PORT=587
EMAIL_HOST_USER=<CHANGE_ME>
EMAIL_HOST_PASSWORD=<CHANGE_ME>
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Onlenco <no-reply@sudaschool.academy>

# --- AI (OpenAI-compatible endpoint) ---
AI_API_KEY=<CHANGE_ME_or_leave_empty_for_deterministic_fallbacks>
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_STT_MODEL=whisper-1
AI_TTS_MODEL=tts-1
AI_TTS_VOICE=alloy

# --- Security ---
ENABLE_2FA_ADMIN=1               # require TOTP for /admin/
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_HOURS=1.0

# --- Logging ---
DJANGO_LOG_LEVEL=INFO

# --- Optional: Celery (leave empty if synchronous notifications are fine) ---
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# --- Caddy / TLS ---
ACME_EMAIL=admin@sudaschool.academy
