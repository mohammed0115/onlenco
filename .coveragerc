[run]
source = .
omit =
    */migrations/*
    */tests/*
    */tests.py
    */__pycache__/*
    .venv/*
    config/settings/test.py
    manage.py
    onlenco/wsgi.py
    onlenco/asgi.py

[report]
exclude_lines =
    pragma: no cover
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
