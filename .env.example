# Core Django
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-strong-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DJANGO_LOG_LEVEL=INFO

# Database
# Keep SQLite for local development. For production, set either:
# 1) DJANGO_DATABASE_URL, or
# 2) the POSTGRES_* variables below.
# DJANGO_DATABASE_URL=postgresql://onlenco:password@127.0.0.1:5432/onlenco
POSTGRES_DB=onlenco
POSTGRES_USER=onlenco
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DJANGO_DB_CONN_MAX_AGE=60
DJANGO_DB_SSL_REQUIRE=1

# Security (production)
DJANGO_SECURE_SSL_REDIRECT=1
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=1
DJANGO_SECURE_HSTS_PRELOAD=1
API_TOKEN_MAX_AGE_DAYS=30

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=info@onlenco.academy
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
# Always wrap with the brand display name so recipients see "Onlenco"
# rather than the SMTP login. EmailService falls back to this format
# automatically if the env value is bare, but pin the canonical form here.
DEFAULT_FROM_EMAIL=Onlenco <info@onlenco.academy>
# Optional override for the wrap label.
EMAIL_BRAND_NAME=Onlenco
# Where replies land when a user hits "Reply" in their inbox. Leave
# blank to omit. Recommended: a real, monitored inbox.
EMAIL_REPLY_TO=support@onlenco.academy
# Public HTTPS base URL — used for the logo fallback inside emails and
# absolute CTA links.
ONLENCO_BASE_URL=https://onlenco.academy

# Optional Celery broker. Leave empty to keep notifications synchronous.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Static/media
DJANGO_STATIC_URL=/static/
DJANGO_MEDIA_URL=/media/

# AI placement scoring (OpenAI-compatible chat-completions endpoint).
# Leave AI_API_KEY blank to use the deterministic heuristic fallback.
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
