# Copy to .env (or export these before running). All are optional in dev.

# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1

# AI placement scoring (OpenAI-compatible chat-completions endpoint).
# Leave AI_API_KEY blank to use the deterministic heuristic fallback.
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
