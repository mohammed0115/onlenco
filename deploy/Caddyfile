# Caddy auto-TLS reverse proxy for Onlenco.
#
# Caddy fetches and renews Let's Encrypt certificates automatically. The
# only requirements are:
#   - DNS A record:  onlenco.academy      → 187.127.86.111
#   - DNS A record:  www.onlenco.academy  → 187.127.86.111
#   - Ports 80 + 443 open on the host firewall.
#
# Set ACME_EMAIL in your shell or .env so Let's Encrypt has a contact.

{
    email {$ACME_EMAIL:admin@onlenco.academy}
    # auto_https on    # the default; uncomment to be explicit
}

onlenco.academy, www.onlenco.academy {
    encode zstd gzip

    # Cache static assets aggressively (whitenoise hashes filenames)
    @static path /static/*
    header @static Cache-Control "public, max-age=31536000, immutable"

    # Strip cookies on static asset responses (defense in depth)
    header @static -Set-Cookie

    # Serve user-uploaded media directly from the shared volume.
    # Django's MEDIA_URL is only wired into urls.py when DEBUG=True, so
    # in production we MUST serve /media/* from Caddy — otherwise every
    # uploaded lesson audio / video / pdf returns 404 to students.
    # The `media_data` volume is mounted read-only on this service in
    # docker-compose.deploy.yml.
    handle_path /media/* {
        root * /srv/media
        file_server
        # Reasonable cache for user uploads (browser revalidates daily).
        header Cache-Control "public, max-age=86400"
    }

    # Cap incoming bodies so a hostile client can't stream 50 GB at us.
    # 500 MB is comfortably above any realistic lesson video upload but
    # well below "indefinite". Adjust if curricula grow larger files.
    request_body {
        max_size 500MB
    }

    reverse_proxy web:8000 {
        # `header_up` keys go INSIDE the reverse_proxy block in Caddy v2.
        # The proxy hints Django expects when SECURE_PROXY_SSL_HEADER is on.
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-For   {remote}
        header_up Host              {host}

        # Health check — matches the Dockerfile HEALTHCHECK.
        # /healthz/ is in SECURE_REDIRECT_EXEMPT in config/settings/production.py
        # so plain-HTTP probes from the docker network get a 200 instead of
        # the 301 they'd otherwise hit from SECURE_SSL_REDIRECT.
        health_uri      /healthz/
        health_interval 30s
        health_timeout  5s
    }
}
# NOTE: do not add a separate `:80 {}` block — Caddy auto-generates an
# HTTP→HTTPS redirect for the named site above, and a duplicate :80 listener
# would conflict and crashloop.
